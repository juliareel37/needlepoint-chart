generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SaveSource {
  MANUAL
  AUTOSAVE
  RESTORE
}

enum AppThemePreference {
  LIGHT
  SYSTEM
  DARK
}

model AppUser {
  id              String              @id @default(cuid())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  themePreference AppThemePreference?
  identities      AuthIdentity[]
  editorDesigns EditorDesign[]
}

model AuthIdentity {
  id             String   @id @default(cuid())
  appUserId      String
  provider       String
  providerUserId String
  email          String?
  displayName    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([appUserId])
  @@index([email])
}

model PatternDraft {
  id              String           @id @default(cuid())
  userId          String
  title           String
  data            Json
  lastSaveSource  SaveSource?
  lastVersionAt   DateTime?
  lastVersionHash String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  versions        PatternVersion[]

  @@index([userId])
}

model PatternVersion {
  id        String       @id @default(cuid())
  draftId   String
  data      Json
  dataHash  String
  saveSource SaveSource?
  createdAt DateTime     @default(now())

  draft PatternDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model EditorDesign {
  id              String              @id @default(cuid())
  appUserId       String
  userId          String
  title           String
  data            Json
  gridWidth       Int
  gridHeight      Int
  lastSaveSource  SaveSource?
  lastVersionAt   DateTime?
  lastVersionHash String?
  deletedAt       DateTime?
  purgeAfterAt    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  versions        EditorDesignVersion[]
  appUser         AppUser             @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId])
  @@index([userId])
  @@index([updatedAt])
  @@index([appUserId, deletedAt, updatedAt])
  @@index([deletedAt, purgeAfterAt])
}

model EditorDesignVersion {
  id         String      @id @default(cuid())
  designId   String
  data       Json
  dataHash   String
  saveSource SaveSource?
  createdAt  DateTime    @default(now())

  design EditorDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
  @@index([designId, createdAt])
}
