generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SaveSource {
  MANUAL
  AUTOSAVE
  RESTORE
}

enum AppThemePreference {
  LIGHT
  SYSTEM
  DARK
}

enum WaitlistApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WaitlistSubmissionAttemptStatus {
  APPROVED
  REJECTED
  DUPLICATE
}

model AppUser {
  id              String              @id @default(cuid())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  themePreference AppThemePreference?
  subscribedToPromotions Boolean      @default(true)
  promotionsUnsubscribedAt DateTime?
  identities      AuthIdentity[]
  editorDesigns   EditorDesign[]
  editorDesignFolders EditorDesignFolder[]
  editorBugReports EditorBugReport[]
}

model AuthIdentity {
  id             String   @id @default(cuid())
  appUserId      String
  provider       String
  providerUserId String
  email          String?
  displayName    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([appUserId])
  @@index([email])
}

model WaitlistApplication {
  id                 String                    @id @default(cuid())
  email              String
  status             WaitlistApplicationStatus @default(PENDING)
  experienceLevel    String?
  currentTools       String?
  freeformResponse   String?
  approvedAt         DateTime?
  approvedBy         String?
  inviteToken        String?                   @unique
  inviteTokenExpiresAt DateTime?
  accountCreatedAt   DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  submissionAttempts WaitlistSubmissionAttempt[]
  surveyResponses    WaitlistSurveyResponse[]

  @@unique([email])
  @@index([status, createdAt])
  @@index([inviteTokenExpiresAt])
}

model WaitlistSurveyResponse {
  id                    String   @id @default(cuid())
  waitlistApplicationId String
  email                 String
  experienceLevel       String
  betaTestingInterest   Boolean  @default(false)
  currentTools          String
  freeformResponse      String
  createdAt             DateTime @default(now())

  waitlistApplication WaitlistApplication @relation(fields: [waitlistApplicationId], references: [id], onDelete: Cascade)

  @@index([waitlistApplicationId, createdAt])
  @@index([email])
  @@index([createdAt])
}

model WaitlistSubmissionAttempt {
  id                    String                          @id @default(cuid())
  status                WaitlistSubmissionAttemptStatus
  rejectionReason       String?
  email                 String?
  normalizedEmail       String?
  experienceLevel       String?
  currentTools          String?
  freeformResponse      String?
  ipAddressHash         String?
  userAgent             String?
  waitlistApplicationId String?
  createdAt             DateTime                        @default(now())

  waitlistApplication WaitlistApplication? @relation(fields: [waitlistApplicationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([normalizedEmail])
  @@index([ipAddressHash, createdAt])
  @@index([waitlistApplicationId])
}

model FeaturedGraphic {
  id             String   @id @default(cuid())
  iconId         String   @unique
  updatedByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model PatternDraft {
  id              String           @id @default(cuid())
  userId          String
  title           String
  data            Json
  lastSaveSource  SaveSource?
  lastVersionAt   DateTime?
  lastVersionHash String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  versions        PatternVersion[]

  @@index([userId])
}

model PatternVersion {
  id        String       @id @default(cuid())
  draftId   String
  data      Json
  dataHash  String
  saveSource SaveSource?
  createdAt DateTime     @default(now())

  draft PatternDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model EditorDesign {
  id              String              @id @default(cuid())
  appUserId       String
  folderId        String?
  userId          String
  title           String
  data            Json
  gridWidth       Int
  gridHeight      Int
  lastSaveSource  SaveSource?
  lastVersionAt   DateTime?
  lastVersionHash String?
  deletedAt       DateTime?
  purgeAfterAt    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  versions        EditorDesignVersion[]
  guestTraceAssets GuestTraceAsset[]
  bugReports      EditorBugReport[]
  appUser         AppUser             @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  folder          EditorDesignFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([appUserId])
  @@index([folderId])
  @@index([userId])
  @@index([updatedAt])
  @@index([appUserId, deletedAt, updatedAt])
  @@index([appUserId, folderId, deletedAt, updatedAt])
  @@index([deletedAt, purgeAfterAt])
}

model EditorDesignFolder {
  id        String         @id @default(cuid())
  appUserId String
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  appUser   AppUser        @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  designs   EditorDesign[]

  @@unique([appUserId, name])
  @@index([appUserId])
}

model EditorDesignVersion {
  id         String      @id @default(cuid())
  designId   String
  data       Json
  dataHash   String
  saveSource SaveSource?
  createdAt  DateTime    @default(now())

  design EditorDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
  @@index([designId, createdAt])
}

model GuestTraceAsset {
  id              String       @id @default(cuid())
  guestDraftId    String
  originalUrl     String       @unique
  previewUrl      String       @unique
  thumbnailUrl    String       @unique
  fileName        String?
  byteSize        Int?
  mimeType        String?
  imageWidth      Int?
  imageHeight     Int?
  claimedDesignId String?
  claimedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  claimedDesign   EditorDesign? @relation(fields: [claimedDesignId], references: [id], onDelete: SetNull)

  @@index([guestDraftId])
  @@index([expiresAt])
  @@index([claimedDesignId])
  @@index([claimedAt])
}

model EditorBugReport {
  id             String      @id @default(cuid())
  appUserId      String?
  editorDesignId String?
  source         String
  formId         String
  formVersion    String?
  answers        Json
  context        Json?
  clientMetadata Json?
  createdAt      DateTime    @default(now())
  appUser        AppUser?    @relation(fields: [appUserId], references: [id], onDelete: SetNull)
  editorDesign   EditorDesign? @relation(fields: [editorDesignId], references: [id], onDelete: SetNull)

  @@index([appUserId, createdAt])
  @@index([editorDesignId, createdAt])
  @@index([source, createdAt])
  @@index([formId, createdAt])
  @@index([createdAt])
}
